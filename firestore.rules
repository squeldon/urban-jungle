rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for property listings
    match /listings/{listingId} {
      // Anyone can read public listings (active, pending, sold, rented) or owners can read all their listings
      allow read: if resource.data.status in ['active', 'pending', 'sold', 'rented'] || 
                     (request.auth != null && request.auth.uid == resource.data.createdBy);
      
      // Only authenticated users can create listings
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.createdBy &&
                       request.resource.data.keys().hasAll(['title', 'description', 'price', 'propertyType', 'listingType', 'address', 'contactInfo', 'createdBy', 'createdAt', 'updatedAt', 'status']) &&
                       request.resource.data.status in ['active', 'inactive', 'pending', 'sold', 'rented', 'withdrawn'] &&
                       request.resource.data.views == 0 &&
                       request.resource.data.favorites.size() == 0;
      
      // Users can update their own listings (full edit)
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.createdBy &&
                       // Prevent updating createdBy, createdAt fields
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt']) &&
                       // Ensure updatedAt is present and is a timestamp
                       request.resource.data.updatedAt is timestamp;
      
      // Allow anyone to increment view count for public listings
      allow update: if resource.data.status in ['active', 'pending', 'sold', 'rented'] &&
                       request.resource.data.diff(resource.data).affectedKeys() == ['views'].toSet() &&
                       request.resource.data.views == resource.data.views + 1;
      
      // Allow authenticated users to add/remove themselves from favorites for public listings
      allow update: if request.auth != null &&
                       resource.data.status in ['active', 'pending', 'sold', 'rented'] &&
                       request.resource.data.diff(resource.data).affectedKeys() == ['favorites'].toSet() &&
                       (
                         // Adding themselves to favorites
                         (request.resource.data.favorites.hasAll(resource.data.favorites) &&
                          request.resource.data.favorites.size() == resource.data.favorites.size() + 1 &&
                          request.resource.data.favorites.hasAll([request.auth.uid])) ||
                         // Removing themselves from favorites  
                         (resource.data.favorites.hasAll(request.resource.data.favorites) &&
                          resource.data.favorites.size() == request.resource.data.favorites.size() + 1 &&
                          resource.data.favorites.hasAll([request.auth.uid]))
                       );
      
      // Users can only delete their own listings
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.createdBy;
    }
    
    // Rules for user profiles (if you plan to add user data)
    match /users/{userId} {
      // Users can read and write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other document access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
